{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CtmsDatabase": "mongodb://localhost:27017"
  },
  "Mongo": {
    "Database": "ctms"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<set-in-user-secrets-or-key-vault>",
    "ClientId": "<set-in-user-secrets-or-key-vault>",
    "Audience": "<set-in-user-secrets-or-key-vault>"
  },
  "Auth": {
    "Enabled": true,
    "PublicBundleReads": true
  }
}
