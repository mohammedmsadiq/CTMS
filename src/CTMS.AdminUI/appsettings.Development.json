{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ctms": {
    "ApiBaseUrl": "http://localhost:8080"
  },
  "ConnectionStrings": {
    // Local dev runs the Admin UI outside docker compose as a single instance, so the
    // ephemeral in-process Data Protection key ring is fine here. Set this (e.g. to
    // "redis:6379") for any multi-replica deployment so keys are shared across replicas.
    "Redis": ""
  },
  "Auth": {
    "Enabled": false
  }
}
