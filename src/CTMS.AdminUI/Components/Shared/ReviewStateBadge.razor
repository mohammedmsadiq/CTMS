<span class="ctms-chip @CssClass" title="@($"Review state: {State}")">@Label</span>

@code {
    /// <summary>
    /// One of the <see cref="ReviewStates"/> names (<c>Draft</c> / <c>InReview</c> /
    /// <c>Approved</c> / <c>Published</c> / <c>Archived</c>). Callers must bind an expression —
    /// remember the leading <c>@</c> (<c>State="@dto.ReviewState"</c>); a bare
    /// <c>State="dto.ReviewState"</c> passes the literal text, not the value.
    /// </summary>
    [Parameter, EditorRequired] public string State { get; set; } = "";

    private string Label => State switch
    {
        ReviewStates.Draft => "Draft",
        ReviewStates.InReview => "In review",
        ReviewStates.Approved => "Approved",
        ReviewStates.Published => "Published",
        ReviewStates.Archived => "Archived",
        _ => string.IsNullOrWhiteSpace(State) ? "Unknown" : State,
    };

    private string CssClass => State switch
    {
        ReviewStates.Draft => "ctms-chip--slate",
        ReviewStates.InReview => "ctms-chip--amber",
        ReviewStates.Approved => "ctms-chip--green",
        ReviewStates.Published => "ctms-chip--blue",
        ReviewStates.Archived => "ctms-chip--muted",
        _ => "ctms-chip--slate",
    };
}
