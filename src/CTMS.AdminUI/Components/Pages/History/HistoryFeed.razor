@page "/applications/{Code}/history"
@attribute [Authorize(Policy = AuthorizationPolicies.CanRead)]
@inject CtmsApiClient Api

<PageTitle>History — CTMS Admin</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="applications">Applications</a></li>
        <li class="breadcrumb-item"><a href="@($"applications/{Code}")">@Code</a></li>
        <li class="breadcrumb-item active" aria-current="page">History</li>
    </ol>
</nav>

<PageHeader Title="History" Lead="@($"Append-only audit trail for {Code}. Newest first.")">
    <Actions>
        <button class="btn btn-outline-secondary" @onclick="ReloadAsync" disabled="@_loading">Refresh</button>
    </Actions>
</PageHeader>

@if (_loading)
{
    <LoadingSpinner Message="Loading history…" />
}
else if (_loadError is not null)
{
    <ErrorAlert Error="_loadError" OnRetry="ReloadAsync" />
}
else if (_page is { Total: 0 })
{
    <EmptyState Title="No history yet" Hint="Edits and review actions on strings will show up here." />
}
else if (_page is not null)
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">When</th>
                    <th scope="col">Entity</th>
                    <th scope="col">Action</th>
                    <th scope="col">Change</th>
                    <th scope="col">Actor</th>
                    <th scope="col">Detail</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in _page.Items)
                {
                    <tr>
                        <td class="text-nowrap">@e.Timestamp.ToLocalTime().ToString("g")</td>
                        <td>@e.EntityType</td>
                        <td>@e.Action</td>
                        <td>
                            @if (!string.IsNullOrEmpty(e.FromState) || !string.IsNullOrEmpty(e.ToState))
                            {
                                <span class="text-nowrap"><StateTransition From="@e.FromState" To="@e.ToState" /></span>
                            }
                            else if (!string.IsNullOrEmpty(e.OldValue) || !string.IsNullOrEmpty(e.NewValue))
                            {
                                <span class="d-inline-block text-truncate align-bottom" style="max-width: 14rem;">
                                    @(string.IsNullOrEmpty(e.OldValue) ? "∅" : e.OldValue)
                                </span>
                                <span class="mx-1" aria-hidden="true">→</span>
                                <span class="d-inline-block text-truncate align-bottom" style="max-width: 14rem;">
                                    @(string.IsNullOrEmpty(e.NewValue) ? "∅" : e.NewValue)
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@e.Actor</td>
                        <td>@(string.IsNullOrWhiteSpace(e.Detail) ? "—" : e.Detail)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">
            Showing @(_page.Total == 0 ? 0 : _skip + 1)–@Math.Min(_skip + _take, _page.Total) of @_page.Total
        </span>
        <div class="btn-group">
            <button class="btn btn-outline-secondary btn-sm" @onclick="PrevPage" disabled="@(_skip == 0 || _loading)">Previous</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="NextPage" disabled="@(_skip + _take >= _page.Total || _loading)">Next</button>
        </div>
    </div>
}

@code {
    [Parameter] public string Code { get; set; } = "";

    private const int _take = 25;
    private int _skip;

    private bool _loading = true;
    private ApiError? _loadError;
    private PagedResult<AuditEntryDto>? _page;

    protected override Task OnParametersSetAsync()
    {
        _skip = 0;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();

        var result = await Api.GetApplicationHistoryAsync(Code, _skip, _take);
        if (result.IsSuccess)
        {
            _page = result.Value;
            if (_skip > 0 && _page!.Items.Count == 0 && _page.Total > 0)
            {
                _skip = Math.Max(0, _skip - _take);
                _loading = false;
                await LoadAsync();
                return;
            }
        }
        else
        {
            _loadError = result.Error;
        }
        _loading = false;
    }

    private Task ReloadAsync()
    {
        _skip = 0;
        return LoadAsync();
    }

    private Task NextPage()
    {
        _skip += _take;
        return LoadAsync();
    }

    private Task PrevPage()
    {
        _skip = Math.Max(0, _skip - _take);
        return LoadAsync();
    }
}
