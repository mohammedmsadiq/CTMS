@page "/projects/{ProjectId:guid}/bundles"
@attribute [Authorize(Policy = AuthorizationPolicies.CanRead)]
@inject CtmsApiClient Api
@inject CurrentUser CurrentUser

<PageTitle>Bundles — CTMS Admin</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="projects">Projects</a></li>
        <li class="breadcrumb-item"><a href="@($"projects/{ProjectId}")">Project</a></li>
        <li class="breadcrumb-item active" aria-current="page">Bundles</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Published bundles</h1>
    <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@_loading">Refresh</button>
</div>

<p class="text-muted small">
    One immutable snapshot per publish. A locale's latest bundle freezes every string currently in
    <strong>Published</strong> review state; publish individual strings from the review queue first.
</p>

@if (_loading)
{
    <LoadingSpinner Message="Loading bundles…" />
}
else if (_loadError is not null)
{
    <ErrorAlert Error="_loadError" OnRetry="LoadAsync" />
}
else if (_rows.Count == 0)
{
    <EmptyState Title="No locales enabled"
                Hint="Add a locale to this project before publishing bundles." />
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Locale</th>
                    <th scope="col" class="text-end">Version</th>
                    <th scope="col" class="text-end">Entries</th>
                    <th scope="col">ETag</th>
                    <th scope="col">Published by</th>
                    <th scope="col">Published at</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td><code>@row.Locale.Code</code></td>
                        @if (row.Latest is not null)
                        {
                            <td class="text-end">v@(row.Latest.Version)</td>
                            <td class="text-end">@row.Latest.Entries.Count</td>
                            <td><code title="@row.Latest.ETag">@Short(row.Latest.ETag)</code></td>
                            <td>@row.Latest.CreatedBy</td>
                            <td class="text-nowrap">@row.Latest.CreatedAt.ToLocalTime().ToString("g")</td>
                        }
                        else
                        {
                            <td colspan="5" class="text-muted">Not published</td>
                        }
                        <td class="text-end text-nowrap">
                            @if (row.Latest is not null)
                            {
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => SelectAsync(row.Locale.Code)">
                                    @(IsSelected(row.Locale.Code) ? "Hide history" : "History")
                                </button>
                            }
                            <AuthorizeView Policy="@AuthorizationPolicies.CanPublish" Context="publish">
                                <button class="btn btn-sm btn-primary" disabled="@row.Busy"
                                        @onclick="() => PublishAsync(row)">
                                    @if (row.Busy)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                    }
                                    Publish
                                </button>
                            </AuthorizeView>
                        </td>
                    </tr>
                    @if (row.Info is not null || row.Error is not null)
                    {
                        <tr>
                            <td colspan="7" class="pt-0">
                                @if (row.Info is not null)
                                {
                                    <div class="alert alert-warning mb-0">@row.Info</div>
                                }
                                @if (row.Error is not null)
                                {
                                    <ErrorAlert Error="row.Error" />
                                }
                            </td>
                        </tr>
                    }
                    @if (IsSelected(row.Locale.Code))
                    {
                        <tr>
                            <td colspan="7" class="bg-body-tertiary">
                                <h2 class="h6 mb-2">Version history — <code>@row.Locale.Code</code></h2>
                                @if (_versionsLoading)
                                {
                                    <LoadingSpinner Message="Loading versions…" />
                                }
                                else if (_versionsError is not null)
                                {
                                    <ErrorAlert Error="_versionsError" OnRetry="() => LoadVersionsAsync(row.Locale.Code)" />
                                }
                                else if (_versions.Count == 0)
                                {
                                    <p class="text-muted small mb-0">No versions yet.</p>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm mb-0">
                                            <thead>
                                                <tr>
                                                    <th scope="col" class="text-end">Version</th>
                                                    <th scope="col">ETag</th>
                                                    <th scope="col" class="text-end">Entries</th>
                                                    <th scope="col">Created</th>
                                                    <th scope="col">By</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var v in _versions)
                                                {
                                                    <tr>
                                                        <td class="text-end">v@(v.Version)</td>
                                                        <td><code title="@v.ETag">@Short(v.ETag)</code></td>
                                                        <td class="text-end">@v.EntryCount</td>
                                                        <td class="text-nowrap">@v.CreatedAt.ToLocalTime().ToString("g")</td>
                                                        <td>@v.CreatedBy</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private bool _loading = true;
    private ApiError? _loadError;
    private readonly List<BundleRow> _rows = new();

    private string? _selectedLocaleCode;
    private bool _versionsLoading;
    private ApiError? _versionsError;
    private readonly List<BundleVersionDto> _versions = new();

    protected override Task OnParametersSetAsync() => LoadAsync();

    private static string Short(string etag) =>
        string.IsNullOrEmpty(etag) || etag.Length <= 12 ? etag : etag[..12] + "…";

    private bool IsSelected(string localeCode) =>
        string.Equals(_selectedLocaleCode, localeCode, StringComparison.Ordinal);

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _rows.Clear();
        _selectedLocaleCode = null;
        _versions.Clear();
        StateHasChanged();

        var localesResult = await Api.GetLocalesAsync(ProjectId);
        if (localesResult.IsFailure)
        {
            _loadError = localesResult.Error;
            _loading = false;
            return;
        }

        foreach (var locale in localesResult.Value!.OrderBy(l => l.Code, StringComparer.OrdinalIgnoreCase))
        {
            var row = new BundleRow(locale);
            await RefreshRowAsync(row);
            _rows.Add(row);
        }

        _loading = false;
    }

    private async Task RefreshRowAsync(BundleRow row)
    {
        var result = await Api.GetBundleAsync(ProjectId, row.Locale.Code);
        if (result.IsSuccess)
        {
            row.Latest = result.Value;
        }
        else if (result.Error!.Status == 404)
        {
            // No bundle has ever been published for this locale — an expected empty state.
            row.Latest = null;
        }
        else
        {
            row.Error = result.Error;
        }
    }

    private async Task SelectAsync(string localeCode)
    {
        if (IsSelected(localeCode))
        {
            _selectedLocaleCode = null;
            _versions.Clear();
            return;
        }

        _selectedLocaleCode = localeCode;
        await LoadVersionsAsync(localeCode);
    }

    private async Task LoadVersionsAsync(string localeCode)
    {
        _versionsLoading = true;
        _versionsError = null;
        _versions.Clear();
        StateHasChanged();

        var result = await Api.GetBundleVersionsAsync(ProjectId, localeCode);
        _versionsLoading = false;

        if (result.IsSuccess)
        {
            // API returns ascending by version; show newest first.
            _versions.AddRange(result.Value!.OrderByDescending(v => v.Version));
        }
        else
        {
            _versionsError = result.Error;
        }
    }

    private async Task PublishAsync(BundleRow row)
    {
        row.Busy = true;
        row.Info = null;
        row.Error = null;
        StateHasChanged();

        var result = await Api.PublishBundleAsync(ProjectId, row.Locale.Code, CurrentUser.DisplayName);
        row.Busy = false;

        if (result.IsSuccess)
        {
            var dto = result.Value!;
            row.Latest = dto;
            if (IsSelected(row.Locale.Code))
            {
                _versions.Insert(0, new BundleVersionDto(
                    dto.Version, dto.ETag, dto.CreatedAt, dto.CreatedBy, dto.Entries.Count));
            }
            return;
        }

        switch (result.Error!.Status)
        {
            case 400:
                row.Info = "Nothing approved-and-published to snapshot for this locale.";
                break;
            case 409:
                row.Info = "Another publish already took the next version. Refreshed to the latest.";
                await RefreshRowAsync(row);
                if (IsSelected(row.Locale.Code))
                {
                    await LoadVersionsAsync(row.Locale.Code);
                }
                break;
            default:
                // 404 (locale not in project) and transport / server errors.
                row.Error = result.Error;
                break;
        }
    }

    private sealed class BundleRow
    {
        public BundleRow(LocaleDto locale) => Locale = locale;

        public LocaleDto Locale { get; }
        public BundleDto? Latest { get; set; }
        public bool Busy { get; set; }
        public string? Info { get; set; }
        public ApiError? Error { get; set; }
    }
}
