@page "/projects"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Policy = AuthorizationPolicies.CanRead)]
@inject CtmsApiClient Api
@inject NavigationManager Nav

<PageTitle>Projects — CTMS Admin</PageTitle>

<PageHeader Title="Projects"
           Lead="Each project owns its own translation keys. The Common project merges its published strings into every other project's delivery.">
    <Actions>
        <AuthorizeView Policy="@AuthorizationPolicies.CanAdminProjects">
            <a class="btn btn-primary" href="projects/new">New project</a>
            <button class="btn btn-outline-secondary" @onclick="ToggleCreate" disabled="@(_languages is null)">
                @(_showCreate ? "Close quick form" : "Quick form")
            </button>
        </AuthorizeView>
    </Actions>
</PageHeader>

@if (_showCreate && _languages is not null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Create a project</h2>
            <EditForm Model="_form" OnValidSubmit="CreateAsync">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="a-name">Name</label>
                        <InputText id="a-name" class="form-control" @bind-Value="_form.Name" />
                        <ValidationMessage For="() => _form.Name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="a-code">Code <span class="text-muted">(optional — derived from name)</span></label>
                        <InputText id="a-code" class="form-control" placeholder="icoach" @bind-Value="_form.Code" />
                        <ValidationMessage For="() => _form.Code" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="a-base">Base language</label>
                        <InputSelect id="a-base" class="form-select" @bind-Value="_form.BaseLanguageCode">
                            <option value="">Choose…</option>
                            @foreach (var lang in _languages)
                            {
                                <option value="@lang.Code">@lang.Name (@lang.Code)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _form.BaseLanguageCode" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="a-desc">Description <span class="text-muted">(optional)</span></label>
                        <InputText id="a-desc" class="form-control" @bind-Value="_form.Description" />
                    </div>
                    <div class="col-12">
                        <span class="form-label d-block">Enabled languages</span>
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var lang in _languages)
                            {
                                var code = lang.Code;
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="@($"en-{code}")"
                                           checked="@_enabled.Contains(code)"
                                           @onchange="e => ToggleEnabled(code, (bool)e.Value!)" />
                                    <label class="form-check-label" for="@($"en-{code}")">@lang.Code</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-12 form-check ms-1">
                        <InputCheckbox id="a-common" class="form-check-input" @bind-Value="_form.IsCommon" />
                        <label class="form-check-label" for="a-common">
                            Common — its published strings merge into every project
                        </label>
                    </div>
                </div>
                <ErrorAlert Error="_createError" />
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        Create
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_loading)
{
    <LoadingSpinner Message="Loading projects…" />
}
else if (_loadError is not null)
{
    <ErrorAlert Error="_loadError" OnRetry="LoadAsync" />
}
else if (_projects is { Count: 0 })
{
    <EmptyState Title="No projects yet"
                Hint="Create your first project — the guided flow sets up its languages and lets you import translations straight away.">
        <AuthorizeView Policy="@AuthorizationPolicies.CanAdminProjects">
            <a class="btn btn-primary" href="projects/new">Create your first project</a>
        </AuthorizeView>
    </EmptyState>
}
else if (_projects is not null)
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Name</th>
                    <th scope="col">Kind</th>
                    <th scope="col">Active</th>
                    <th scope="col" class="text-end">Languages</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in _projects)
                {
                    <tr class="cursor-pointer" @onclick="() => Open(project.Code)">
                        <td><a href="@($"projects/{project.Code}")"><code>@project.Code</code></a></td>
                        <td>@project.Name</td>
                        <td>
                            @if (project.IsCommon)
                            {
                                <span class="badge text-bg-info">Common</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@(project.Active ? "Yes" : "No")</td>
                        <td class="text-end">@project.EnabledLanguageCodes.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _showCreate;
    private ApiError? _loadError;
    private ApiError? _createError;
    private IReadOnlyList<ProjectDto>? _projects;
    private IReadOnlyList<LanguageDto>? _languages;
    private readonly HashSet<string> _enabled = new(StringComparer.OrdinalIgnoreCase);
    private readonly CreateProjectForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        var languages = await Api.GetLanguagesAsync();
        if (languages.IsSuccess)
        {
            _languages = languages.Value;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        var result = await Api.GetProjectsAsync(includeInactive: true);
        if (result.IsSuccess)
        {
            _projects = result.Value;
        }
        else
        {
            _loadError = result.Error;
        }
        _loading = false;
    }

    private void ToggleCreate() => _showCreate = !_showCreate;

    private void ToggleEnabled(string code, bool on)
    {
        if (on)
        {
            _enabled.Add(code);
        }
        else
        {
            _enabled.Remove(code);
        }
    }

    private async Task CreateAsync()
    {
        _saving = true;
        _createError = null;
        var request = new CreateProjectRequest(
            _form.Name.Trim(),
            _form.BaseLanguageCode.Trim(),
            string.IsNullOrWhiteSpace(_form.Code) ? null : _form.Code.Trim(),
            string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description.Trim(),
            _form.IsCommon,
            _enabled.Count == 0 ? null : _enabled.ToArray());

        var result = await Api.CreateProjectAsync(request);
        _saving = false;

        if (result.IsSuccess)
        {
            Nav.NavigateTo($"projects/{result.Value!.Code}");
        }
        else
        {
            _createError = result.Error;
        }
    }

    private void Open(string code) => Nav.NavigateTo($"projects/{code}");

    private sealed class CreateProjectForm
    {
        [Required, StringLength(200, MinimumLength = 1)]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Choose a base language.")]
        [Display(Name = "Base language")]
        public string BaseLanguageCode { get; set; } = "";

        [RegularExpression("^[a-z0-9]+(?:-[a-z0-9]+)*$", ErrorMessage = "Lower-case letters, digits and hyphens only.")]
        public string? Code { get; set; }

        [StringLength(500)]
        public string? Description { get; set; }

        public bool IsCommon { get; set; }
    }
}
