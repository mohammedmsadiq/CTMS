@page "/applications/{Code}/review"
@attribute [Authorize(Policy = AuthorizationPolicies.CanRead)]
@inject CtmsApiClient Api
@inject CurrentUser CurrentUser

<PageTitle>Review queue — CTMS Admin</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="applications">Applications</a></li>
        <li class="breadcrumb-item"><a href="@($"applications/{Code}")">@Code</a></li>
        <li class="breadcrumb-item active" aria-current="page">Review queue</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Review queue</h1>
    <button class="btn btn-outline-secondary" @onclick="ReloadAsync" disabled="@_loading">Refresh</button>
</div>

<p class="text-muted small">Strings currently in <strong>NeedsReview</strong> for <code>@Code</code>.</p>

@if (_loading)
{
    <LoadingSpinner Message="Loading review queue…" />
}
else if (_loadError is not null)
{
    <ErrorAlert Error="_loadError" OnRetry="ReloadAsync" />
}
else if (_page is { Total: 0 })
{
    <EmptyState Title="Nothing to review" Hint="No strings are waiting for review." />
}
else if (_page is not null)
{
    <ErrorAlert Error="_rowError" />
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Key</th>
                    <th scope="col">Language</th>
                    <th scope="col">Value</th>
                    <th scope="col">Updated by</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _page.Items)
                {
                    <tr>
                        <td>
                            <a href="@($"applications/{Code}/grid?search={Uri.EscapeDataString(KeyName(s.TranslationKeyId))}")">
                                <code>@KeyName(s.TranslationKeyId)</code>
                            </a>
                        </td>
                        <td><code>@s.LanguageCode</code></td>
                        <td class="text-truncate" style="max-width: 28rem;">@s.Value</td>
                        <td>@(string.IsNullOrWhiteSpace(s.UpdatedBy) ? "—" : s.UpdatedBy)</td>
                        <td class="text-end text-nowrap">
                            <AuthorizeView Policy="@AuthorizationPolicies.CanReview" Context="review">
                                <button class="btn btn-sm btn-outline-success" disabled="@(_busyId == s.Id)"
                                        @onclick="() => ReviewAsync(s, ReviewActions.Approve)">Approve</button>
                                <button class="btn btn-sm btn-outline-danger" disabled="@(_busyId == s.Id)"
                                        @onclick="() => ReviewAsync(s, ReviewActions.Reject)">Reject</button>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">
            Showing @(_page.Total == 0 ? 0 : _skip + 1)–@Math.Min(_skip + _take, _page.Total) of @_page.Total
        </span>
        <div class="btn-group">
            <button class="btn btn-outline-secondary btn-sm" @onclick="PrevPage" disabled="@(_skip == 0 || _loading)">Previous</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="NextPage" disabled="@(_skip + _take >= _page.Total || _loading)">Next</button>
        </div>
    </div>
}

@code {
    [Parameter] public string Code { get; set; } = "";

    private const int _take = 50;
    private int _skip;

    private bool _loading = true;
    private Guid _busyId;
    private ApiError? _loadError;
    private ApiError? _rowError;
    private PagedResult<TranslationStringDto>? _page;
    private readonly Dictionary<Guid, string> _keyNames = new();
    private string? _loadedCode;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedCode != Code)
        {
            _loadedCode = Code;
            _skip = 0;
            await LoadKeyNamesAsync();
        }

        await LoadAsync();
    }

    private async Task LoadKeyNamesAsync()
    {
        _keyNames.Clear();
        var skip = 0;
        const int pageSize = 200;
        while (true)
        {
            var result = await Api.GetKeysAsync(Code, null, skip, pageSize);
            if (result.IsFailure)
            {
                return;
            }

            foreach (var key in result.Value!.Items)
            {
                _keyNames[key.Id] = key.KeyName;
            }

            skip += pageSize;
            if (skip >= result.Value.Total || result.Value.Items.Count == 0)
            {
                break;
            }
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _rowError = null;
        var result = await Api.GetApplicationStringsAsync(Code, ReviewStates.NeedsReview, _skip, _take);
        if (result.IsSuccess)
        {
            _page = result.Value;
            if (_skip > 0 && _page!.Items.Count == 0 && _page.Total > 0)
            {
                _skip = Math.Max(0, _skip - _take);
                _loading = false;
                await LoadAsync();
                return;
            }
        }
        else
        {
            _loadError = result.Error;
        }
        _loading = false;
    }

    private Task ReloadAsync()
    {
        _skip = 0;
        return LoadAsync();
    }

    private Task NextPage()
    {
        _skip += _take;
        return LoadAsync();
    }

    private Task PrevPage()
    {
        _skip = Math.Max(0, _skip - _take);
        return LoadAsync();
    }

    private string KeyName(Guid keyId) =>
        _keyNames.TryGetValue(keyId, out var name) ? name : keyId.ToString()[..8];

    private async Task ReviewAsync(TranslationStringDto s, string action)
    {
        _busyId = s.Id;
        _rowError = null;
        var result = await Api.ReviewStringAsync(
            Code, s.TranslationKeyId, s.LanguageCode, new ReviewRequest(action, CurrentUser.DisplayName));
        _busyId = Guid.Empty;

        if (result.IsSuccess)
        {
            await LoadAsync();
        }
        else
        {
            _rowError = result.Error;
        }
    }
}
