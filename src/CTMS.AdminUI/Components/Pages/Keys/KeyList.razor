@page "/applications/{Code}/keys"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Policy = AuthorizationPolicies.CanRead)]
@inject CtmsApiClient Api
@inject NavigationManager Nav

<PageTitle>Keys — CTMS Admin</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="applications">Applications</a></li>
        <li class="breadcrumb-item"><a href="@($"applications/{Code}")">@Code</a></li>
        <li class="breadcrumb-item active" aria-current="page">Keys</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Translation keys</h1>
    <AuthorizeView Policy="@AuthorizationPolicies.CanManageContent">
        <button class="btn btn-primary" @onclick="() => _showCreate = !_showCreate">
            @(_showCreate ? "Close" : "New key")
        </button>
    </AuthorizeView>
</div>

<div class="row g-2 align-items-end mb-3">
    <div class="col-sm-4 col-md-3">
        <label class="form-label small mb-1" for="cat-filter">Category</label>
        <select id="cat-filter" class="form-select form-select-sm" value="@_category" @onchange="OnCategoryChanged">
            <option value="">All categories</option>
            @foreach (var cat in _categories)
            {
                <option value="@cat">@cat</option>
            }
        </select>
    </div>
</div>

@if (_showCreate)
{
    <div class="card mb-4">
        <div class="card-body">
            <EditForm Model="_form" OnValidSubmit="CreateAsync">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="k-name">Key name</label>
                        <InputText id="k-name" class="form-control" placeholder="checkout.button.submit" @bind-Value="_form.KeyName" />
                        <ValidationMessage For="() => _form.KeyName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="k-cat">Category</label>
                        <InputText id="k-cat" class="form-control" list="cat-options" placeholder="Checkout" @bind-Value="_form.Category" />
                        <datalist id="cat-options">
                            @foreach (var cat in _categories)
                            {
                                <option value="@cat" />
                            }
                        </datalist>
                        <ValidationMessage For="() => _form.Category" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="k-desc">Description <span class="text-muted">(optional)</span></label>
                        <InputText id="k-desc" class="form-control" @bind-Value="_form.Description" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100" disabled="@_saving">Create</button>
                    </div>
                </div>
                <ErrorAlert Error="_createError" />
            </EditForm>
        </div>
    </div>
}

@if (_loading)
{
    <LoadingSpinner Message="Loading keys…" />
}
else if (_loadError is not null)
{
    <ErrorAlert Error="_loadError" OnRetry="LoadAsync" />
}
else if (_page is { Total: 0 })
{
    <EmptyState Title="No keys" Hint="Create a translation key, then edit its values on the grid." />
}
else if (_page is not null)
{
    <ErrorAlert Error="_rowError" />
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Key</th>
                    <th scope="col">Category</th>
                    <th scope="col">Description</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var key in _page.Items)
                {
                    var editing = _editingId == key.Id;
                    <tr>
                        <td>
                            <a href="@($"applications/{Code}/grid?search={Uri.EscapeDataString(key.KeyName)}")">
                                <code>@key.KeyName</code>
                            </a>
                            @if (!key.Active)
                            {
                                <span class="badge text-bg-light ms-2">inactive</span>
                            }
                        </td>
                        <td>
                            @if (editing)
                            {
                                <input class="form-control form-control-sm" @bind="_editCategory" list="cat-options" aria-label="Category" style="max-width: 12rem;" />
                            }
                            else
                            {
                                <span class="badge text-bg-light">@key.Category</span>
                            }
                        </td>
                        <td>
                            @if (editing)
                            {
                                <input class="form-control form-control-sm" @bind="_editDescription" aria-label="Description" />
                            }
                            else
                            {
                                @(string.IsNullOrWhiteSpace(key.Description) ? "—" : key.Description)
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary"
                               href="@($"applications/{Code}/grid?search={Uri.EscapeDataString(key.KeyName)}")">Edit values</a>
                            <AuthorizeView Policy="@AuthorizationPolicies.CanManageContent" Context="mutate">
                                @if (editing)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveEditAsync(key)" disabled="@_saving">Save</button>
                                    <button class="btn btn-sm btn-link" @onclick="() => _editingId = null" disabled="@_saving">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => BeginEdit(key)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => _pendingDelete = key">Delete</button>
                                }
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">
            Showing @(_page.Total == 0 ? 0 : _skip + 1)–@Math.Min(_skip + _take, _page.Total) of @_page.Total
        </span>
        <div class="btn-group">
            <button class="btn btn-outline-secondary btn-sm" @onclick="PrevPage" disabled="@(_skip == 0 || _loading)">Previous</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="NextPage" disabled="@(_skip + _take >= _page.Total || _loading)">Next</button>
        </div>
    </div>
}

<ConfirmDialog Visible="_pendingDelete is not null"
               Title="Delete key"
               Message="@($"Delete key \"{_pendingDelete?.KeyName}\"? All its translation strings are removed too.")"
               ConfirmLabel="Delete"
               Busy="_saving"
               OnConfirm="DeleteConfirmedAsync"
               OnCancel="() => _pendingDelete = null" />

@code {
    [Parameter] public string Code { get; set; } = "";

    private const int _take = 25;
    private int _skip;
    private string _category = "";

    private bool _loading = true;
    private bool _saving;
    private bool _showCreate;
    private ApiError? _loadError;
    private ApiError? _createError;
    private ApiError? _rowError;
    private PagedResult<TranslationKeyDto>? _page;
    private IReadOnlyList<string> _categories = Array.Empty<string>();
    private readonly CreateKeyForm _form = new();

    private Guid? _editingId;
    private string _editCategory = "";
    private string _editDescription = "";
    private TranslationKeyDto? _pendingDelete;

    protected override async Task OnParametersSetAsync()
    {
        _skip = 0;
        _category = "";
        var categories = await Api.GetCategoriesAsync(Code);
        _categories = categories.IsSuccess ? categories.Value! : Array.Empty<string>();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _editingId = null;
        var result = await Api.GetKeysAsync(Code, string.IsNullOrEmpty(_category) ? null : _category, _skip, _take);
        if (result.IsSuccess)
        {
            _page = result.Value;
            if (_skip > 0 && _page!.Items.Count == 0 && _page.Total > 0)
            {
                _skip = Math.Max(0, _skip - _take);
                _loading = false;
                await LoadAsync();
                return;
            }
        }
        else
        {
            _loadError = result.Error;
        }
        _loading = false;
    }

    private Task OnCategoryChanged(ChangeEventArgs e)
    {
        _category = e.Value?.ToString() ?? "";
        _skip = 0;
        return LoadAsync();
    }

    private Task NextPage()
    {
        _skip += _take;
        return LoadAsync();
    }

    private Task PrevPage()
    {
        _skip = Math.Max(0, _skip - _take);
        return LoadAsync();
    }

    private async Task CreateAsync()
    {
        _saving = true;
        _createError = null;
        var result = await Api.CreateKeyAsync(Code, new CreateTranslationKeyRequest(
            _form.KeyName.Trim(),
            _form.Category.Trim(),
            string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description.Trim()));
        _saving = false;

        if (result.IsSuccess)
        {
            _form.KeyName = "";
            _form.Description = "";
            _showCreate = false;
            _skip = 0;
            var categories = await Api.GetCategoriesAsync(Code);
            if (categories.IsSuccess)
            {
                _categories = categories.Value!;
            }
            await LoadAsync();
        }
        else
        {
            _createError = result.Error;
        }
    }

    private void BeginEdit(TranslationKeyDto key)
    {
        _rowError = null;
        _editingId = key.Id;
        _editCategory = key.Category;
        _editDescription = key.Description ?? "";
    }

    private async Task SaveEditAsync(TranslationKeyDto key)
    {
        _saving = true;
        _rowError = null;
        var result = await Api.UpdateKeyAsync(Code, key.Id, new UpdateTranslationKeyRequest(
            Category: string.IsNullOrWhiteSpace(_editCategory) ? null : _editCategory.Trim(),
            Description: string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription.Trim()));
        _saving = false;

        if (result.IsSuccess)
        {
            _editingId = null;
            await LoadAsync();
        }
        else
        {
            _rowError = result.Error;
        }
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_pendingDelete is null)
        {
            return;
        }

        _saving = true;
        _rowError = null;
        var result = await Api.DeleteKeyAsync(Code, _pendingDelete.Id);
        _saving = false;
        _pendingDelete = null;

        if (result.IsSuccess)
        {
            await LoadAsync();
        }
        else
        {
            _rowError = result.Error;
        }
    }

    private sealed class CreateKeyForm
    {
        [Required]
        [RegularExpression("^[A-Za-z0-9_.-]+$", ErrorMessage = "Only letters, digits, dot, underscore and hyphen.")]
        [Display(Name = "Key name")]
        public string KeyName { get; set; } = "";

        [Required(ErrorMessage = "Category is required.")]
        [StringLength(100, MinimumLength = 1)]
        public string Category { get; set; } = "";

        [StringLength(500)]
        public string? Description { get; set; }
    }
}
