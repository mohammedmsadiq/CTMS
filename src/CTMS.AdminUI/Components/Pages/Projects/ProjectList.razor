@page "/projects"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Policy = AuthorizationPolicies.CanRead)]
@inject CtmsApiClient Api
@inject NavigationManager Nav

<PageTitle>Projects — CTMS Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Projects</h1>
    <AuthorizeView Policy="@AuthorizationPolicies.CanAdminProjects">
        <button class="btn btn-primary" @onclick="() => _showCreate = !_showCreate">
            @(_showCreate ? "Close" : "New project")
        </button>
    </AuthorizeView>
</div>

@if (_showCreate)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Create a project</h2>
            <EditForm Model="_form" OnValidSubmit="CreateAsync">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="p-name">Name</label>
                        <InputText id="p-name" class="form-control" @bind-Value="_form.Name" />
                        <ValidationMessage For="() => _form.Name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="p-base">Base locale code</label>
                        <InputText id="p-base" class="form-control" placeholder="en-US" @bind-Value="_form.BaseLocaleCode" />
                        <ValidationMessage For="() => _form.BaseLocaleCode" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="p-slug">Slug <span class="text-muted">(optional)</span></label>
                        <InputText id="p-slug" class="form-control" placeholder="derived from name" @bind-Value="_form.Slug" />
                        <ValidationMessage For="() => _form.Slug" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="p-desc">Description <span class="text-muted">(optional)</span></label>
                        <InputText id="p-desc" class="form-control" @bind-Value="_form.Description" />
                    </div>
                </div>
                <ErrorAlert Error="_createError" />
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        Create
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_loading)
{
    <LoadingSpinner Message="Loading projects…" />
}
else if (_loadError is not null)
{
    <ErrorAlert Error="_loadError" OnRetry="LoadAsync" />
}
else if (_projects is { Count: 0 })
{
    <EmptyState Title="No projects yet" Hint="Create the first project to start managing translations." />
}
else if (_projects is not null)
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Slug</th>
                    <th scope="col">Base locale</th>
                    <th scope="col">Description</th>
                    <th scope="col">Updated</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _projects)
                {
                    <tr class="cursor-pointer" @onclick="() => Open(p.Id)">
                        <td><a href="@($"projects/{p.Id}")">@p.Name</a></td>
                        <td><code>@p.Slug</code></td>
                        <td>@p.BaseLocaleCode</td>
                        <td class="text-truncate" style="max-width: 24rem;">@p.Description</td>
                        <td>@p.UpdatedAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _showCreate;
    private ApiError? _loadError;
    private ApiError? _createError;
    private IReadOnlyList<ProjectDto>? _projects;
    private readonly CreateProjectForm _form = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        var result = await Api.GetProjectsAsync();
        if (result.IsSuccess)
        {
            _projects = result.Value;
        }
        else
        {
            _loadError = result.Error;
        }
        _loading = false;
    }

    private async Task CreateAsync()
    {
        _saving = true;
        _createError = null;
        var request = new CreateProjectRequest(
            _form.Name.Trim(),
            _form.BaseLocaleCode.Trim(),
            string.IsNullOrWhiteSpace(_form.Slug) ? null : _form.Slug.Trim(),
            string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description.Trim());

        var result = await Api.CreateProjectAsync(request);
        _saving = false;

        if (result.IsSuccess)
        {
            Nav.NavigateTo($"projects/{result.Value!.Id}");
        }
        else
        {
            _createError = result.Error;
        }
    }

    private void Open(Guid id) => Nav.NavigateTo($"projects/{id}");

    private sealed class CreateProjectForm
    {
        [Required, StringLength(200, MinimumLength = 1)]
        public string Name { get; set; } = "";

        [Required, StringLength(35, MinimumLength = 2)]
        [Display(Name = "Base locale code")]
        public string BaseLocaleCode { get; set; } = "";

        [RegularExpression("^[a-z0-9]+(?:-[a-z0-9]+)*$", ErrorMessage = "Lower-case letters, digits and hyphens only.")]
        public string? Slug { get; set; }

        [StringLength(500)]
        public string? Description { get; set; }
    }
}
