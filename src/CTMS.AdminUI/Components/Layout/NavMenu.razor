@implements IDisposable
@inject NavigationManager Nav
@inject CtmsApiClient Api

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CTMS Admin</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="projects" Match="NavLinkMatch.Prefix">
                <span class="bi bi-folder2-open-nav-menu" aria-hidden="true"></span> Projects
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="languages" Match="NavLinkMatch.Prefix">
                <span class="bi bi-globe2-nav-menu" aria-hidden="true"></span> Languages
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.Prefix">
                <span class="bi bi-info-circle-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        @if (_projectCode is { } code)
        {
            <div class="nav-context px-3 pt-3 pb-1 text-uppercase small">
                @(_projectName ?? code)
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"projects/{code}")" Match="NavLinkMatch.All">
                    <span class="bi bi-info-circle-nav-menu" aria-hidden="true"></span> Overview
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"projects/{code}/grid")">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Grid
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"projects/{code}/import")">
                    <span class="bi bi-box-nav-menu" aria-hidden="true"></span> Import
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"projects/{code}/review")">
                    <span class="bi bi-check2-square-nav-menu" aria-hidden="true"></span> Review
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"projects/{code}/missing")">
                    <span class="bi bi-key-nav-menu" aria-hidden="true"></span> Missing
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"projects/{code}/publish")">
                    <span class="bi bi-box-nav-menu" aria-hidden="true"></span> Publish
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"projects/{code}/history")">
                    <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> History
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private string? _projectCode;
    private string? _projectName;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        _ = SyncToLocationAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = SyncToLocationAsync();

    private async Task SyncToLocationAsync()
    {
        var previous = _projectCode;
        _projectCode = ExtractProjectCode(Nav.ToBaseRelativePath(Nav.Uri));

        if (!string.Equals(_projectCode, previous, StringComparison.Ordinal))
        {
            _projectName = null;
            await InvokeAsync(StateHasChanged);

            if (_projectCode is { } code)
            {
                var result = await Api.GetProjectAsync(code);
                if (result.IsSuccess && string.Equals(_projectCode, code, StringComparison.Ordinal))
                {
                    _projectName = result.Value!.Name;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
    }

    private static string? ExtractProjectCode(string relativePath)
    {
        var path = relativePath.Split('?', '#')[0];
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        return segments.Length >= 2 && segments[0].Equals("projects", StringComparison.OrdinalIgnoreCase)
            ? Uri.UnescapeDataString(segments[1])
            : null;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
