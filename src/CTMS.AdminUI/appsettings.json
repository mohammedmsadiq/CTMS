{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ctms": {
    "ApiBaseUrl": "http://localhost:8080",
    "ApiScope": "<set-in-user-secrets-or-key-vault>"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<set-in-user-secrets-or-key-vault>",
    "ClientId": "<set-in-user-secrets-or-key-vault>",
    "CallbackPath": "/signin-oidc"
  },
  "Auth": {
    "Enabled": true
  }
}
