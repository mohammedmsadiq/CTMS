# Copy to `.env` and adjust for your machine. `docker compose` reads it automatically.
# Nothing secret belongs here — this file is committed. Values below are defaults
# or placeholders; real secrets go in an untracked `.env` or the shell environment.

# ---- Host port mappings ------------------------------------------------------
# Only used by docker-compose.yml (the dev stack). docker-compose.prod.yml stops
# publishing mongo/redis to the host entirely.
API_PORT=8080
MONGO_PORT=27017
REDIS_PORT=6379

# ---- Datastore ------------------------------------------------------------
# Mongo connection string. Inside the compose network the host is `mongo`.
# For a real Cosmos DB for MongoDB account, paste its connection string here.
CTMS_DATABASE__CONNECTION_STRING=mongodb://mongo:27017
#   -> ConnectionStrings__CtmsDatabase

# Mongo database name.
MONGO_DATABASE=ctms
#   -> Mongo__Database

# ---- Cache / DataProtection key ring ---------------------------------------
# Redis connection string (StackExchange.Redis format: host:port[,options]).
# Also backs the ASP.NET DataProtection key ring, so keys persist across
# api container restarts.
CTMS_REDIS__CONNECTION_STRING=redis:6379
#   -> ConnectionStrings__Redis

# ---- Host --------------------------------------------------------------------
# ASP.NET Core environment: Development | Staging | Production
# docker-compose.prod.yml forces this to Production regardless.
ASPNETCORE_ENVIRONMENT=Development

# Seed demo data on startup. Forced to false by docker-compose.prod.yml.
SEED_ENABLED=true
#   -> Seed__Enabled

# ---- Auth (Entra ID / JWT bearer) ----------------------------------------
# Dev stack default is auth OFF (synthetic all-roles principal). The prod
# override forces AUTH_ENABLED on and requires the AZUREAD_* values below.
AUTH_ENABLED=false
#   -> Auth__Enabled

# Allow anonymous reads of the published translation bundle even when auth is on.
AUTH_PUBLIC_BUNDLE_READS=true
#   -> Auth__PublicBundleReads

# Entra ID app registration the API validates bearer tokens against.
# The API is a token VALIDATOR — it needs tenant id, client id and audience but
# NO client secret. (The Admin UI is the confidential client that holds a secret.)
#AZUREAD_INSTANCE=https://login.microsoftonline.com/
#   -> AzureAd__Instance
#AZUREAD_TENANT_ID=00000000-0000-0000-0000-000000000000
#   -> AzureAd__TenantId
#AZUREAD_CLIENT_ID=00000000-0000-0000-0000-000000000000
#   -> AzureAd__ClientId
#AZUREAD_AUDIENCE=api://ctms
#   -> AzureAd__Audience

# ---- Request hardening --------------------------------------------------
# Rate limiting. Dev stack default is OFF so manual testing doesn't 429.
# The prod override forces RateLimit__Enabled=true and reads the tuning knobs.
# App defaults: PermitPerWindow=120, WindowSeconds=60, QueueLimit=0,
# BundlePermitPerWindow=PermitPerWindow*5.
RATELIMIT_ENABLED=false
#   -> RateLimit__Enabled
#RATELIMIT_PERMIT_PER_WINDOW=120
#   -> RateLimit__PermitPerWindow
#RATELIMIT_WINDOW_SECONDS=60
#   -> RateLimit__WindowSeconds
#RATELIMIT_QUEUE_LIMIT=0
#   -> RateLimit__QueueLimit
#RATELIMIT_BUNDLE_PERMIT_PER_WINDOW=600
#   -> RateLimit__BundlePermitPerWindow

# CORS allow-list. Origin index 0; add CTMS_ALLOWED_ORIGIN_1... in a custom
# override for more. Required by docker-compose.prod.yml. Empty/absent -> the
# API allows no cross-origin request at all.
#CTMS_ALLOWED_ORIGIN=https://admin.ctms.example.com
#   -> Cors__AllowedOrigins__0

# Max request body size in bytes. Left unset -> app default (262144 = 256 KB).
#LIMITS__MAX_REQUEST_BODY_BYTES=262144
#   -> Limits__MaxRequestBodyBytes
