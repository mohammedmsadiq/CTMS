# Copy to `.env` and adjust for your machine. `docker compose` reads it automatically.
# Nothing secret belongs here — this file is committed.

# ---- Host port mappings ------------------------------------------------------
API_PORT=8080
MONGO_PORT=27017
REDIS_PORT=6379

# ---- API configuration (mapped to ASP.NET Core config keys) ----------------
# Mongo connection string. Inside the compose network the host is `mongo`.
# For a real Cosmos DB for MongoDB account, paste its connection string here.
CTMS_DATABASE__CONNECTION_STRING=mongodb://mongo:27017
#   -> ConnectionStrings__CtmsDatabase

# Mongo database name.
MONGO_DATABASE=ctms
#   -> Mongo__Database

# Redis connection string (StackExchange.Redis format: host:port[,options]).
CTMS_REDIS__CONNECTION_STRING=redis:6379
#   -> ConnectionStrings__Redis

# ASP.NET Core environment: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Seed demo data on startup.
SEED_ENABLED=true
#   -> Seed__Enabled
